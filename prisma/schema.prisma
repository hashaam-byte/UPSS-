// U-Plus - Combined Prisma Schema
// Merged from Schema 1 (Subject Selection System) + Schema 2 (Production Schema)
// Generated: 2026-02-22

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================
enum UserRole {
  HEADADMIN
  ADMIN
  TEACHER
  STUDENT
}
enum TeacherRole {
  DIRECTOR
  COORDINATOR
  SUBJECT_TEACHER
}

enum Gender {
  male
  female
  other
}

enum SubjectCategory {
  CORE
  SCIENCE
  ARTS
  COMMERCIAL
  VOCATIONAL
  ELECTIVE
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum MessageType {
  direct
  broadcast
  system
  announcement
}

enum MessagePriority {
  low
  normal
  high
  urgent
}

enum NotificationType {
  info
  success
  warning
  error
  system
}

enum ApprovalStatus {
  pending
  approved
  rejected
  revision_requested
}

enum AssignmentType {
  homework
  project
  quiz
  exam
  essay
  lab_report
  presentation
  research
  classwork
}

enum AssignmentStatus {
  draft
  active
  closed
  cancelled
}

enum SubmissionStatus {
  submitted
  graded
  returned
  late
  missing
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  partial
}

enum AssessmentType {
  test
  exam
  quiz
  assignment
  project
  midterm
  final
  continuous_assessment
  practical
}

enum AlertType {
  performance_concern
  attendance_issue
  behavioral_issue
  parent_meeting_required
  academic_support_needed
  commendation
  disciplinary_action
}

enum AlertStatus {
  active
  in_progress
  resolved
  escalated
}

enum EventType {
  class
  exam
  meeting
  event
  deadline
  reminder
  parent_meeting
}

enum AccessLevel {
  public
  school
  class
  teacher_only
  admin_only
}

enum CommunicationType {
  academic_concern
  behavioral_issue
  attendance_alert
  positive_feedback
  meeting_request
  general_update
  emergency_contact
}

enum CommunicationMethod {
  email
  sms
  phone_call
  in_person
  video_call
  letter
}

enum CommunicationStatus {
  draft
  sent
  delivered
  read
  responded
  failed
}

enum AnnouncementStatus {
  draft
  published
  scheduled
  expired
  archived
}

// ============================================================================
// SCHOOL
// ============================================================================

model School {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String    @db.VarChar(255)
  slug                     String    @unique @db.VarChar(100)
  address                  String
  phone                    String    @db.VarChar(20)
  email                    String    @db.VarChar(255)
  logo                     String?   @db.VarChar(500)
  website                  String?   @db.VarChar(255)
  isActive                 Boolean   @default(true) @map("is_active")

  // Subscription
  subscriptionPlan         String    @default("trial") @map("subscription_plan")
  subscriptionExpiresAt    DateTime  @default(dbgenerated("(NOW() + INTERVAL '1 year')")) @map("subscription_expires_at") @db.Timestamptz
  subscriptionIsActive     Boolean   @default(true) @map("subscription_is_active")

  // Settings
  allowStudentRegistration Boolean   @default(false) @map("allow_student_registration")
  requireEmailVerification Boolean   @default(true) @map("require_email_verification")
  maxStudents              Int       @default(1000) @map("max_students")
  maxTeachers              Int       @default(100) @map("max_teachers")
  customNextPaymentDays    Int?      @map("custom_next_payment_days")
  recurringPaymentMonths   Int?      @map("recurring_payment_months")

  createdBy                String?   @map("created_by") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users                    User[]
  classes                  Class[]   @relation("SchoolClasses")
  subjects                 Subject[]
  academicTerms            AcademicTerm[]
  assignments              Assignment[]
  submissions              AssignmentSubmission[]
  attendance               Attendance[]
  grades                   Grade[]
  studentAlerts            StudentAlert[]
  calendarEvents           CalendarEvent[]
  timetables               Timetable[]
  messages                 Message[]
  notifications            Notification[]
  announcements            Announcement[]
  resourceFolders          ResourceFolder[]
  resources                Resource[]
  fileUploads              FileUpload[]
  parentCommunications     ParentCommunication[]
  invoices                 Invoice[]
  payments                 Payment[]
  attendancePatterns       StudentAttendancePattern[]
  performanceMetrics       StudentPerformanceMetrics[]
  studentSubjectSelections StudentSubjectSelection[]
  subjectStreams            SubjectStream[]

  @@index([slug])
  @@index([isActive])
  @@map("schools")
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName               String    @map("first_name") @db.VarChar(100)
  lastName                String    @map("last_name") @db.VarChar(100)
  email                   String    @db.VarChar(255)
  username                String?   @db.VarChar(100)
  passwordHash            String    @map("password_hash") @db.VarChar(255)
  role                    UserRole
  schoolId                String?   @map("school_id") @db.Uuid
  avatar                  String?   @db.VarChar(500)
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  phone                   String?   @db.VarChar(20)
  address                 String?
  gender                  Gender?
  isActive                Boolean   @default(true) @map("is_active")
  isEmailVerified         Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken  String?   @map("email_verification_token") @db.VarChar(255)
  passwordResetToken      String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires    DateTime? @map("password_reset_expires") @db.Timestamptz
  lastLogin               DateTime? @map("last_login") @db.Timestamptz
  loginAttempts           Int       @default(0) @map("login_attempts")
  lockUntil               DateTime? @map("lock_until") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school                  School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  adminProfile            AdminProfile?
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  settings                UserSettings?         @relation("UserToUserSettings")
  sentMessages            Message[]             @relation("SentMessages")
  receivedMessages        Message[]             @relation("ReceivedMessages")
  notifications           Notification[]
  auditLogs               AuditLog[]
  verifiedInvoices        Invoice[]             @relation("InvoiceVerifier")
  cancelledInvoices       Invoice[]             @relation("InvoiceCanceller")
  processedPayments       Payment[]             @relation("PaymentProcessor")
  createdResourceFolders  ResourceFolder[]      @relation("UserCreatedFolders")
  uploadedResources       Resource[]            @relation("UserUploadedResources")
  taughtLessons           Timetable[]           @relation("TimetableTeacher")
  createdTimetables       Timetable[]           @relation("TimetableCreator")
  coordinatorApprovals    TimetableApproval[]   @relation("CoordinatorApprovals")
  directorApprovals       TimetableApproval[]   @relation("DirectorApprovals")
  coordinatorReports      CoordinatorReport[]   @relation("CoordinatorReports")
  createdAssignments      Assignment[]          @relation("AssignmentTeacher")
  submissions             AssignmentSubmission[] @relation("StudentSubmissions")
  gradedSubmissions       AssignmentSubmission[] @relation("SubmissionGrader")
  attendance              Attendance[]          @relation("StudentAttendance")
  markedAttendance        Attendance[]          @relation("AttendanceMarker")
  receivedGrades          Grade[]               @relation("StudentGrades")
  givenGrades             Grade[]               @relation("TeacherGrades")
  createdGrades           Grade[]               @relation("GradeCreator")
  studentAlerts           StudentAlert[]        @relation("StudentAlerts")
  createdAlerts           StudentAlert[]        @relation("AlertCreator")
  resolvedAlerts          StudentAlert[]        @relation("AlertResolver")
  createdEvents           CalendarEvent[]       @relation("EventCreator")
  attendancePatterns      StudentAttendancePattern[]  @relation("StudentAttendancePattern")
  performanceMetrics      StudentPerformanceMetrics[] @relation("StudentPerformanceMetrics")
  studentCommunications   ParentCommunication[]       @relation("StudentCommunications")
  initiatedCommunications ParentCommunication[]       @relation("InitiatedCommunications")
  uploads                 FileUpload[]                @relation("UserUploads")
  createdAnnouncements    Announcement[]              @relation("CreatedAnnouncements")

  @@unique([email, schoolId])
  @@unique([username, schoolId])
  @@index([email])
  @@index([username, schoolId])
  @@index([role, schoolId, isActive])
  @@map("users")
}

model UserSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  hashedToken String?   @map("hashed_token") @db.VarChar(255)
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address") @db.Inet
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  ipAddress String?   @map("ip_address") @db.Inet
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================================================
// PROFILES
// ============================================================================

model StudentProfile {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                       String    @unique @map("user_id") @db.Uuid
  studentId                    String?   @unique @map("student_id") @db.VarChar(50)
  className                    String?   @map("class_name") @db.VarChar(50)
  section                      String?   @db.VarChar(10)
  department                   String?   @db.VarChar(50)
  admissionDate                DateTime? @map("admission_date") @db.Date
  middleName                   String?   @map("middle_name") @db.VarChar(100)
  dateOfBirth                  DateTime? @map("date_of_birth") @db.Date
  gender                       String?   @db.VarChar(20)
  classId                      String?   @map("class_id") @db.Uuid
  bloodGroup                   String?   @map("blood_group") @db.VarChar(5)
  allergies                    String?
  emergencyContact             String?   @map("emergency_contact")
  profileImage                 String?   @map("profile_image") @db.VarChar(500)
  address                      String?
  hasCompletedSubjectSelection Boolean   @default(false) @map("has_completed_subject_selection")
  currentStream                String?   @map("current_stream") @db.VarChar(20)
  parentName                   String?   @map("parent_name") @db.VarChar(200)
  parentPhone                  String?   @map("parent_phone") @db.VarChar(20)
  parentEmail                  String?   @map("parent_email") @db.VarChar(255)
  isActive                     Boolean   @default(true) @map("is_active")
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class                        Class?    @relation("StudentClass", fields: [classId], references: [id])
  subjectSelection             StudentSubjectSelection?

  @@map("student_profiles")
}

model TeacherProfile {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String      @unique @map("user_id") @db.Uuid
  employeeId               String?     @unique @map("employee_id") @db.VarChar(50)
  department               String?     @db.VarChar(100)
  qualification            String?     @db.VarChar(255)
  experienceYears          Int         @default(0) @map("experience_years")
  joiningDate              DateTime?   @map("joining_date") @db.Date
  coordinatorClass         String?     @db.VarChar(10)
  teacherRole              TeacherRole @default(SUBJECT_TEACHER) @map("teacher_role")
  levelSpecialization      String?     @map("level_specialization") @db.VarChar(20)
  canTeachStreams           String[]    @map("can_teach_streams")
  profileImage             String?     @map("profile_image") @db.VarChar(500)
  phone                    String?     @db.VarChar(20)
  isActive                 Boolean     @default(true) @map("is_active")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherSubjects          TeacherSubject[]
  teacherClassCoordinators TeacherClassCoordinator[]

  @@map("teacher_profiles")
}

model AdminProfile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  employeeId   String?   @unique @map("employee_id") @db.VarChar(50)
  department   String?   @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  profileImage String?   @map("profile_image") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions  AdminPermission[]

  @@map("admin_profiles")
}

model AdminPermission {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminProfileId String       @map("admin_profile_id") @db.Uuid
  module         String       @db.VarChar(50)
  actions        String[]
  canCreate      Boolean      @default(false) @map("can_create")
  canRead        Boolean      @default(true)  @map("can_read")
  canUpdate      Boolean      @default(false) @map("can_update")
  canDelete      Boolean      @default(false) @map("can_delete")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  adminProfile   AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)

  @@unique([adminProfileId, module])
  @@map("admin_permissions")
}

model UserSettings {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  emailNotifications    Boolean  @default(true)  @map("email_notifications")
  pushNotifications     Boolean  @default(true)  @map("push_notifications")
  smsNotifications      Boolean  @default(false) @map("sms_notifications")
  assignmentReminders   Boolean  @default(true)  @map("assignment_reminders")
  gradeNotifications    Boolean  @default(true)  @map("grade_notifications")
  attendanceAlerts      Boolean  @default(true)  @map("attendance_alerts")
  profileVisibility     Boolean  @default(true)  @map("profile_visibility")
  showPerformance       Boolean  @default(false) @map("show_performance")
  theme                 String   @default("light") @db.VarChar(20)
  language              String   @default("en")    @db.VarChar(10)
  preferences           Json?    @default("{}")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user                  User     @relation("UserToUserSettings", fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================================================
// CLASSES & ACADEMIC STRUCTURE
// ============================================================================

model Class {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId                 String    @db.Uuid
  name                     String    @db.VarChar(100)
  code                     String    @unique @db.VarChar(20)
  classLevel               String    @map("class_level") @db.VarChar(10)
  section                  String?   @db.VarChar(5)
  academicYear             String    @map("academic_year") @db.VarChar(10)
  streamType               String?   @map("stream_type") @db.VarChar(20)
  isStreamSpecific         Boolean   @default(false) @map("is_stream_specific")
  capacity                 Int?
  roomNumber               String?   @map("room_number") @db.VarChar(20)
  isActive                 Boolean   @default(true) @map("is_active")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school                   School    @relation("SchoolClasses", fields: [schoolId], references: [id], onDelete: Cascade)
  students                 StudentProfile[] @relation("StudentClass")
  teacherClassCoordinators TeacherClassCoordinator[]
  timetables               Timetable[]

  @@index([schoolId])
  @@index([classLevel])
  @@map("classes")
}

model TeacherClassCoordinator {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId String         @db.Uuid
  classId   String         @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz

  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@map("teacher_class_coordinators")
}

model AcademicTerm {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String    @db.Uuid
  name                String    @db.VarChar(100)
  shortName           String    @db.VarChar(20)
  academicYear        String    @db.VarChar(20)
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime  @map("end_date") @db.Date
  isActive            Boolean   @default(false) @map("is_active")
  isCurrent           Boolean   @default(false) @map("is_current")
  isEnrollmentOpen    Boolean   @default(false) @map("is_enrollment_open")
  midtermDeadline     DateTime? @map("midterm_deadline") @db.Date
  finalGradeDeadline  DateTime? @map("final_grade_deadline") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grades              Grade[]
  performanceMetrics  StudentPerformanceMetrics[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isActive])
  @@map("academic_terms")
}

// ============================================================================
// SUBJECTS
// ============================================================================

model Subject {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String          @db.Uuid
  name             String          @db.VarChar(100)
  code             String          @db.VarChar(60)
  description      String?
  category         SubjectCategory @default(CORE)
  classLevel       String[]        @map("class_level")
  eligibleStreams   String[]        @map("eligible_streams")
  isElectiveOption Boolean         @default(false) @map("is_elective_option")
  electiveGroup    String?         @map("elective_group") @db.VarChar(20)
  maxStudents      Int?            @map("max_students")
  creditHours      Int?            @map("credit_hours")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers         TeacherSubject[]
  assignments      Assignment[]
  grades           Grade[]
  selectedByStudents StudentSelectedSubject[]
  streamMappings     SubjectStreamMapping[]
  prerequisites      SubjectPrerequisite[] @relation("Prerequisites")
  prerequisiteFor    SubjectPrerequisite[] @relation("PrerequisiteFor")

  @@unique([code, schoolId])
  @@index([schoolId])
  @@index([category])
  @@index([isActive])
  @@map("subjects")
}

model TeacherSubject {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId  String         @db.Uuid
  subjectId  String         @db.Uuid
  classes    String[]
  assignedAt DateTime       @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy String?        @map("assigned_by") @db.Uuid
  isActive   Boolean        @default(true) @map("is_active")

  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject    Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

// ============================================================================
// SUBJECT SELECTION SYSTEM
// ============================================================================

model StudentSubjectSelection {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String    @unique @map("student_id") @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  classLevel        String    @map("class_level") @db.VarChar(10)
  stream            String?   @db.VarChar(20)
  isLocked          Boolean   @default(false) @map("is_locked")
  selectionComplete Boolean   @default(false) @map("selection_complete")
  lastModifiedBy    String?   @map("last_modified_by") @db.Uuid
  lastModifiedAt    DateTime? @map("last_modified_at") @db.Timestamptz
  academicYear      String    @map("academic_year") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  student           StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school            School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjects          StudentSelectedSubject[]
  changeHistory     SubjectSelectionHistory[]

  @@index([schoolId, classLevel])
  @@index([studentId])
  @@index([stream])
  @@map("student_subject_selections")
}

model StudentSelectedSubject {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selectionId String    @map("selection_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  isCore      Boolean   @default(false) @map("is_core")
  isElective  Boolean   @default(false) @map("is_elective")
  selectedAt  DateTime  @default(now()) @map("selected_at") @db.Timestamptz

  selection   StudentSubjectSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  subject     Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([selectionId, subjectId])
  @@index([selectionId])
  @@index([subjectId])
  @@map("student_selected_subjects")
}

model SubjectSelectionHistory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  selectionId      String    @map("selection_id") @db.Uuid
  action           String    @db.VarChar(30)
  previousStream   String?   @map("previous_stream") @db.VarChar(20)
  newStream        String?   @map("new_stream") @db.VarChar(20)
  previousSubjects Json?     @map("previous_subjects")
  newSubjects      Json?     @map("new_subjects")
  modifiedBy       String    @map("modified_by") @db.Uuid
  modifiedByRole   String    @map("modified_by_role") @db.VarChar(20)
  reason           String?
  timestamp        DateTime  @default(now()) @db.Timestamptz

  selection        StudentSubjectSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId])
  @@index([timestamp])
  @@index([modifiedBy])
  @@map("subject_selection_history")
}

model SubjectStream {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  name             String    @db.VarChar(20)
  displayName      String    @map("display_name") @db.VarChar(50)
  description      String?
  classLevel       String    @map("class_level") @db.VarChar(5)
  isActive         Boolean   @default(true) @map("is_active")
